---
---

<section
  id="home"
  class="relative pt-24 pb-16 md:pt-32 md:pb-24 border-b border-util-border overflow-hidden"
>
  <!-- Decorative background elements -->
  <div class="absolute inset-0 z-0 pointer-events-none opacity-20">
    <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-util-accent/20 blur-[120px] rounded-full"></div>
    <div class="absolute bottom-1/4 left-1/4 w-64 h-64 bg-util-surface/50 blur-[80px] rounded-full"></div>
  </div>

  <div class="container-util relative z-10">
    <div class="max-w-4xl">
      <!-- <div class="inline-flex items-center space-x-2 border border-util-border bg-util-surface px-3 py-1 mb-8 animate-fade-in">
        <span class="w-2 h-2 bg-util-accent animate-blink"></span>
        <span class="text-xs font-mono text-util-text uppercase tracking-wider">System Online // No Logs</span>
      </div> -->

      <h1
        class="text-5xl md:text-7xl lg:text-8xl font-medium tracking-tighter text-util-heading mb-6 leading-none animate-slide-up"
        style="animation-delay: 0.1s"
      >
        INTERNET <span class="text-util-accent italic">BERSIH.</span>
        <br />
        TANPA{" "}
        <span class="text-util-border line-through decoration-util-accent">
          GANGGUAN.
        </span>
      </h1>

      <p
        class="text-lg md:text-xl text-util-text mb-10 max-w-2xl font-light leading-relaxed animate-slide-up"
        style="animation-delay: 0.2s"
      >
        DNS server untuk memblokir judi online, iklan, pornografi, tracker, dan
        telemetri. Privasi terjamin 100% dengan no-logs policy.
      </p>

      <div
        class="flex flex-col sm:flex-row gap-4 animate-slide-up"
        style="animation-delay: 0.3s"
      >
        <a href="#dns" class="btn-primary group">
          <span>Inisialisasi Setup</span>
          <svg
            class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="square"
              stroke-linejoin="miter"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"
            ></path>
          </svg>
        </a>
        <a href="#features" class="btn-secondary">
          {" "}
          Fitur{" "}
        </a>
      </div>

      <!-- Stats / Technical Output -->
      <div
        class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-px bg-util-border border border-util-border animate-slide-up"
        style="animation-delay: 0.4s"
      >
        <div class="bg-util-bg p-4 flex flex-col">
          <span class="text-xs font-mono text-util-text uppercase mb-1">
            Latency
          </span>
          <span class="text-xl font-mono text-util-heading">&lt; 20ms</span>
        </div>
        <div class="bg-util-bg p-4 flex flex-col">
          <span class="text-xs font-mono text-util-text uppercase mb-1">
            Uptime
          </span>
          <span class="text-xl font-mono text-util-heading">99.9%</span>
        </div>
        <div class="bg-util-bg p-4 flex flex-col">
          <span class="text-xs font-mono text-util-text uppercase mb-1">
            Blocklist
          </span>
          <span class="text-xl font-mono text-util-heading">7M+ Rules</span>
        </div>
        <div class="bg-util-bg p-4 flex flex-col">
          <span class="text-xs font-mono text-util-text uppercase mb-1">
            Privacy
          </span>
          <span class="text-xl font-mono text-util-accent">Zero Logs</span>
        </div>
      </div>
    </div>
  </div>
</section>
