---

---

<section id="report" class="py-24 border-b border-util-border relative">
  <div class="container-util">
    <!-- Section header -->
    <div class="mb-16 border-b border-util-border pb-8">
      <div class="inline-flex items-center space-x-2 mb-4">
        <span
          class="text-xs font-mono text-util-accent uppercase tracking-widest"
          >// CROWDSOURCING & FEEDBACK</span
        >
      </div>
      <h2
        class="text-3xl sm:text-5xl font-medium text-util-heading tracking-tight mb-6"
      >
        LAPORKAN SITUS
      </h2>
      <p class="text-lg text-util-text max-w-2xl font-light">
        Bantu kami menjaga integritas database. Laporkan domain berbahaya yang
        lolos, atau domain aman yang terblokir (false-positive).
      </p>
    </div>

    <!-- Report Types -->
    <div
      class="grid grid-cols-1 lg:grid-cols-3 gap-px bg-util-border border border-util-border mb-16"
    >
      <!-- Report Unblocked Gambling Sites -->
      <div
        class="bg-util-surface p-8 group hover:bg-util-surface-hover transition-colors"
      >
        <div class="mb-8">
          <span class="text-xs font-mono text-util-accent block mb-2"
            >[ INFILTRATION ]</span
          >
          <h3 class="text-xl font-medium text-util-heading mb-4">
            Lapor Domain Judi
          </h3>
          <p class="text-sm text-util-text font-light mb-6">
            Domain taruhan, slot, atau kasino online yang berhasil melewati
            sistem filter DNS.
          </p>
          <ul class="text-xs font-mono text-util-text/70 space-y-2 mb-8">
            <li>> Butuh URL lengkap</li>
            <li>> Jenis permainan</li>
            <li>> Timestamp akses</li>
          </ul>
        </div>
        <a
          href="https://github.com/akbxr/dns/issues/new?template=block-request.md&title=[BLOCK]%20Situs%20Judi%20Belum%20Diblokir&labels=gambling,block-request"
          target="_blank"
          class="w-full btn-secondary text-center block"
        >
          Submit Report
        </a>
      </div>

      <!-- Report Adult Content Sites -->
      <div
        class="bg-util-surface p-8 group hover:bg-util-surface-hover transition-colors"
      >
        <div class="mb-8">
          <span class="text-xs font-mono text-util-text block mb-2"
            >[ NSFW_CONTENT ]</span
          >
          <h3 class="text-xl font-medium text-util-heading mb-4">
            Lapor Domain Dewasa
          </h3>
          <p class="text-sm text-util-text font-light mb-6">
            Konten pornografi, eksploitasi, atau situs khusus dewasa yang belum
            masuk blacklist.
          </p>
          <ul class="text-xs font-mono text-util-text/70 space-y-2 mb-8">
            <li>> Butuh URL lengkap</li>
            <li>> Kategori konten</li>
            <li>> Timestamp akses</li>
          </ul>
        </div>
        <a
          href="https://github.com/akbxr/dns/issues/new?template=block-request.md&title=[BLOCK]%20Konten%20Dewasa%20Belum%20Diblokir&labels=adult-content,block-request"
          target="_blank"
          class="w-full btn-secondary text-center block"
        >
          Submit Report
        </a>
      </div>

      <!-- Report False Positive -->
      <div
        class="bg-util-surface p-8 group hover:bg-util-surface-hover transition-colors"
      >
        <div class="mb-8">
          <span class="text-xs font-mono text-util-text block mb-2"
            >[ FALSE_POSITIVE ]</span
          >
          <h3 class="text-xl font-medium text-util-heading mb-4">
            Lapor Situs Legal
          </h3>
          <p class="text-sm text-util-text font-light mb-6">
            Layanan atau domain publik esensial yang terblokir secara tidak
            sengaja oleh mesin filter.
          </p>
          <ul class="text-xs font-mono text-util-text/70 space-y-2 mb-8">
            <li>> Butuh URL yang terblokir</li>
            <li>> Kegunaan domain</li>
            <!-- <li>> Detail error page</li> -->
          </ul>
        </div>
        <a
          href="https://github.com/akbxr/dns/issues/new?template=false-positive.md&title=[FALSE%20POSITIVE]%20Situs%20Legal%20Terblokir&labels=false-positive,unblock-request"
          target="_blank"
          class="w-full btn-secondary text-center block"
        >
          Request Unblock
        </a>
      </div>
    </div>

    <!-- Repository Info -->
    <div
      class="border border-util-border bg-util-bg p-8 text-center flex flex-col items-center"
    >
      <span
        class="text-xs font-mono text-util-text uppercase tracking-widest mb-4"
        >Source Code / Database</span
      >
      <a
        href="https://github.com/akbxr/dns"
        target="_blank"
        class="text-xl font-mono text-util-heading hover:text-util-accent transition-colors flex items-center gap-4"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path
            fill-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            clip-rule="evenodd"></path>
        </svg>
        github.com/akbxr/dns
      </a>
      <p class="text-sm text-util-text mt-4 font-light">
        Seluruh ruleset dan source code publik. Transparansi absolut.
      </p>
    </div>
  </div>
</section>
