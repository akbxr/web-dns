---
---

<section id="dns" class="py-24 border-b border-util-border relative">
  <div class="container-util">
    <!-- Section header -->
    <div class="mb-16 border-b border-util-border pb-8">
      <div class="inline-flex items-center space-x-2 mb-4">
        <span class="text-xs font-mono text-util-accent uppercase tracking-widest">
          // DEPLOYMENT CONFIG
        </span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-medium text-util-heading tracking-tight mb-6">
        ALAMAT DNS SERVER
      </h2>
      <p class="text-lg text-util-text max-w-2xl font-light">
        Pasang DNS ke dalam sistem. Cocok untuk semua router, operating system,
        dan modern browser.
      </p>
    </div>

    <!-- DNS Configurations -->
    <div class="grid grid-cols-1 gap-px bg-util-border border border-util-border">
      <!-- DoT -->
      <div class="bg-util-surface p-8 md:p-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-8 group hover:bg-util-surface-hover transition-colors">
        <div class="max-w-md">
          <div class="flex items-center space-x-3 mb-3">
            <div class="w-1.5 h-1.5 bg-util-accent animate-pulse-slow"></div>
            <h3 class="text-2xl font-mono font-bold text-util-heading tracking-tight">
              DNS-over-TLS [DoT]
            </h3>
          </div>
          <p class="text-util-text font-light leading-relaxed">
            Protokol enkripsi native untuk Private DNS di Android 9+ dan router
            modern (MikroTik, OpenWrt).
          </p>
        </div>
        <div class="w-full md:w-auto">
          <div class="dns-address">
            <span class="mr-8">dns.akbxr.com</span>
            <button class="copy-btn" data-copy="dns.akbxr.com">
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="square"
                  stroke-linejoin="miter"
                  stroke-width="1.5"
                  d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                ></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- DoH -->
      <div class="bg-util-surface p-8 md:p-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-8 group hover:bg-util-surface-hover transition-colors">
        <div class="max-w-md">
          <div class="flex items-center space-x-3 mb-3">
            <div class="w-1.5 h-1.5 bg-util-text"></div>
            <h3 class="text-2xl font-mono font-bold text-util-heading tracking-tight">
              DNS-over-HTTPS [DoH]
            </h3>
          </div>
          <p class="text-util-text font-light leading-relaxed">
            Melewati firewall jaringan melalui port 443. Direkomendasikan untuk
            konfigurasi Chrome, Firefox, Edge, Safari.
          </p>
        </div>
        <div class="w-full md:w-auto">
          <div class="dns-address">
            <span class="mr-8">https://dns.akbxr.com/dns-query</span>
            <button
              class="copy-btn"
              data-copy="https://dns.akbxr.com/dns-query"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="square"
                  stroke-linejoin="miter"
                  stroke-width="1.5"
                  d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                ></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- IPv4 -->
      <div class="bg-util-surface p-8 md:p-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-8 group hover:bg-util-surface-hover transition-colors">
        <div class="max-w-md">
          <div class="flex items-center space-x-3 mb-3">
            <div class="w-1.5 h-1.5 bg-util-border border border-util-text"></div>
            <h3 class="text-2xl font-mono font-bold text-util-text tracking-tight">
              Legacy IPv4
            </h3>
          </div>
          <p class="text-util-text/70 font-light leading-relaxed">
            Koneksi raw non-enkripsi port 53. Hanya gunakan jika perangkat Anda
            tidak mendukung DoT/DoH (contoh: Smart TV lama, Konsol lawas).
          </p>
        </div>
        <div class="w-full md:w-auto">
          <div class="dns-address bg-util-bg/50 border-util-border/50 text-util-text">
            <span class="mr-8">34.171.234.178</span>
            <button
              class="copy-btn text-util-text/50"
              data-copy="34.171.234.178"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="square"
                  stroke-linejoin="miter"
                  stroke-width="1.5"
                  d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                ></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Script to handle copy -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const copyButtons = document.querySelectorAll(".copy-btn");
        copyButtons.forEach((button) => {
          button.addEventListener("click", async (e) => {
            e.preventDefault();
            const textToCopy = button.getAttribute("data-copy") || "";
            try {
              await navigator.clipboard.writeText(textToCopy);
              const originalHTML = button.innerHTML;
              button.innerHTML =
                '<span class="text-xs font-mono text-util-accent uppercase">COPIED</span>';
              setTimeout(() => {
                button.innerHTML = originalHTML;
              }, 2000);
            } catch (err) {
              console.error("Copy failed: ", err);
            }
          });
        });
      });
    </script>
  </div>
</section>
