---
---

<section id="setup" class="py-24 border-b border-util-border">
  <div class="container-util">
    <div class="mb-16 border-b border-util-border pb-8">
      <div class="inline-flex items-center space-x-2 mb-4">
        <span class="text-xs font-mono text-util-accent uppercase tracking-widest">
          // MANUAL INSTALASI
        </span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-medium text-util-heading tracking-tight mb-6">
        PROSEDUR SETUP
      </h2>
      <p class="text-lg text-util-text max-w-2xl font-light">
        Panduan teknis pemasangan DNS di berbagai lingkungan sistem operasi.
      </p>
    </div>

    <!-- Tabs -->
    <div class="border border-util-border bg-util-surface">
      <div class="flex overflow-x-auto border-b border-util-border scrollbar-hide">
        <button
          class="tab-btn active px-6 py-4 font-mono text-sm tracking-wide text-util-heading border-b-2 border-util-accent whitespace-nowrap bg-util-bg"
          data-target="android"
        >
          ANDROID
        </button>
        <button
          class="tab-btn px-6 py-4 font-mono text-sm tracking-wide text-util-text hover:text-util-heading border-b-2 border-transparent hover:bg-util-bg/50 whitespace-nowrap"
          data-target="ios"
        >
          IOS
        </button>
        <button
          class="tab-btn px-6 py-4 font-mono text-sm tracking-wide text-util-text hover:text-util-heading border-b-2 border-transparent hover:bg-util-bg/50 whitespace-nowrap"
          data-target="windows"
        >
          WINDOWS
        </button>
        <button
          class="tab-btn px-6 py-4 font-mono text-sm tracking-wide text-util-text hover:text-util-heading border-b-2 border-transparent hover:bg-util-bg/50 whitespace-nowrap"
          data-target="mac"
        >
          MACOS
        </button>
        <button
          class="tab-btn px-6 py-4 font-mono text-sm tracking-wide text-util-text hover:text-util-heading border-b-2 border-transparent hover:bg-util-bg/50 whitespace-nowrap"
          data-target="router"
        >
          ROUTER
        </button>
      </div>

      <div class="p-8 md:p-12 min-h-[400px]">
        <!-- Android -->
        <div id="android" class="tab-content active animate-fade-in">
          <div class="grid md:grid-cols-2 gap-12">
            <div>
              <h3 class="text-2xl font-medium text-util-heading mb-6">
                Konfigurasi Private DNS (Android 9+)
              </h3>
              <ol class="space-y-6">
                <li class="flex">
                  <span class="font-mono text-util-accent mr-4">01</span>
                  <p class="text-util-text">
                    Buka menu{" "}
                    <strong class="text-util-heading">
                      Pengaturan (Settings)
                    </strong>
                  </p>
                </li>
                <li class="flex">
                  <span class="font-mono text-util-accent mr-4">02</span>
                  <p class="text-util-text">
                    Navigasi ke{" "}
                    <strong class="text-util-heading">
                      Jaringan & Internet
                    </strong>{" "}
                    &gt;{" "}
                    <strong class="text-util-heading">
                      DNS Pribadi (Private DNS)
                    </strong>
                  </p>
                </li>
                <li class="flex">
                  <span class="font-mono text-util-accent mr-4">03</span>
                  <p class="text-util-text">
                    Pilih opsi{" "}
                    <strong class="text-util-heading">
                      Nama host penyedia DNS Pribadi
                    </strong>
                  </p>
                </li>
                <li class="flex">
                  <span class="font-mono text-util-accent mr-4">04</span>
                  <div>
                    <p class="text-util-text mb-3">
                      Masukkan hostname berikut:
                    </p>
                    <code class="block bg-util-bg border border-util-border p-3 text-util-heading font-mono text-sm">
                      dns.akbxr.com
                    </code>
                  </div>
                </li>
                <li class="flex">
                  <span class="font-mono text-util-accent mr-4">05</span>
                  <p class="text-util-text">
                    Tekan <strong class="text-util-heading">Simpan</strong>.
                    Sistem kini terlindungi.
                  </p>
                </li>
              </ol>
            </div>
            <div class="border border-util-border bg-util-bg p-6 flex flex-col justify-center text-center">
              <!-- <span class="text-util-text/50 font-mono text-sm block mb-4"
                >[ DIAGNOSTIC ]</span
              > -->
              <p class="text-util-text text-sm">
                Untuk Android 8 ke bawah, gunakan aplikasi{" "}
                <span class="text-util-heading">Rethink</span> atau{" "}
                <span class="text-util-heading">Intra</span> dan masukkan URL
                DoH:{" "}
                <code class="text-util-heading block mt-2">
                  https://dns.akbxr.com/dns-query
                </code>
              </p>
            </div>
          </div>
        </div>

        <!-- iOS -->
        <div id="ios" class="tab-content hidden">
          <div class="mb-12">
            <h3 class="text-2xl font-medium text-util-heading mb-2">
              Konfigurasi iOS
            </h3>
            <p class="text-util-text">
              Pilih mode instalasi sesuai dengan versi sistem operasi perangkat
              Anda.
            </p>
          </div>

          <div class="space-y-16">
            <!-- Method 1 -->
            <div>
              <div class="flex flex-col md:flex-row md:items-center space-y-2 md:space-y-0 md:space-x-4 mb-8 border-b border-util-border pb-4">
                <span class="text-xs font-mono bg-util-accent text-util-heading px-2 py-1 tracking-widest uppercase">
                  Direkomendasikan
                </span>
                <h4 class="text-xl font-medium text-util-heading">
                  Metode 01: Pasang via DNS Profile
                </h4>
                <span class="text-sm font-mono text-util-text/50 md:ml-auto">
                  iOS 14+
                </span>
              </div>
              <ol class="space-y-8 max-w-2xl">
                <li class="flex">
                  <span class="font-mono text-util-accent mr-4">01</span>
                  <div>
                    <p class="text-util-text mb-2">
                      <strong class="text-util-heading">
                        Akses Generator Tools
                      </strong>
                    </p>
                    <p class="text-util-text text-sm">
                      Buka{" "}
                      <a
                        href="https://dns.notjakob.com/tool.html"
                        target="_blank"
                        class="text-util-heading hover:text-util-accent underline decoration-util-border underline-offset-4 transition-colors"
                      >
                        dns.notjakob.com/tool.html
                      </a>{" "}
                      menggunakan browser Safari pada perangkat Anda.
                    </p>
                  </div>
                </li>
                <li class="flex">
                  <span class="font-mono text-util-accent mr-4">02</span>
                  <div class="w-full">
                    <p class="text-util-text mb-3">
                      <strong class="text-util-heading">Input Parameter</strong>
                    </p>
                    <div class="bg-util-bg border border-util-border p-4 text-sm font-mono space-y-3">
                      <div class="flex flex-col sm:flex-row sm:justify-between border-b border-util-border/50 pb-2">
                        <span class="text-util-text/50">
                          Name of DNS provider:
                        </span>
                        <span class="text-util-heading">AKBXR DNS</span>
                      </div>
                      <div class="flex flex-col sm:flex-row sm:justify-between border-b border-util-border/50 pb-2">
                        <span class="text-util-text/50">Type:</span>
                        <span class="text-util-heading">
                          DNS-over-TLS (DoT)
                        </span>
                      </div>
                      <div class="flex flex-col sm:flex-row sm:justify-between border-b border-util-border/50 pb-2">
                        <span class="text-util-text/50">IPv4 primary DNS:</span>
                        <span class="text-util-heading">34.171.234.178</span>
                      </div>
                      <div class="flex flex-col sm:flex-row sm:justify-between">
                        <span class="text-util-text/50">DoT server URL:</span>
                        <span class="text-util-heading">dns.akbxr.com</span>
                      </div>
                    </div>
                  </div>
                </li>
                <li class="flex">
                  <span class="font-mono text-util-accent mr-4">03</span>
                  <div>
                    <p class="text-util-text mb-2">
                      <strong class="text-util-heading">
                        Kompilasi & Unduh
                      </strong>
                    </p>
                    <p class="text-util-text text-sm">
                      Ketuk <strong class="text-util-heading">Continue</strong>{" "}
                      kemudian
                      <strong class="text-util-heading">Download</strong>.
                      Izinkan Safari untuk mengunduh profil konfigurasi.
                    </p>
                  </div>
                </li>
                <li class="flex">
                  <span class="font-mono text-util-accent mr-4">✓</span>
                  <div>
                    <p class="text-util-text mb-2">
                      <strong class="text-util-heading">Aktivasi Sistem</strong>
                    </p>
                    <p class="text-util-text text-sm">
                      Buka <strong class="text-util-heading">Settings</strong> >{" "}
                      <strong class="text-util-heading">General</strong> >{" "}
                      <strong class="text-util-heading">
                        VPN & Device Management
                      </strong>
                      . Pilih profil DNS yang baru diunduh dan ketuk Install.
                    </p>
                  </div>
                </li>
              </ol>
            </div>

            <!-- Method 2 -->
            <div>
              <div class="flex flex-col md:flex-row md:items-center space-y-2 md:space-y-0 md:space-x-4 mb-8 border-b border-util-border pb-4">
                <span class="text-xs font-mono border border-util-text text-util-text px-2 py-1 tracking-widest uppercase">
                  Legacy Setup
                </span>
                <h4 class="text-xl font-medium text-util-heading">
                  Metode 02: Konfigurasi Manual (Per Jaringan Wi-Fi)
                </h4>
                <span class="text-sm font-mono text-util-text/50 md:ml-auto">
                  iOS 13-
                </span>
              </div>
              <ol class="space-y-8 max-w-2xl">
                <li class="flex">
                  <span class="font-mono text-util-text mr-4">01</span>
                  <p class="text-util-text">
                    Buka <strong class="text-util-heading">Settings</strong>{" "}
                    &gt;
                    <strong class="text-util-heading">Wi-Fi</strong>
                  </p>
                </li>
                <li class="flex">
                  <span class="font-mono text-util-text mr-4">02</span>
                  <p class="text-util-text">
                    Ketuk ikon <strong class="text-util-heading">"i"</strong> di
                    samping jaringan Wi-Fi yang terhubung saat ini
                  </p>
                </li>
                <li class="flex">
                  <span class="font-mono text-util-text mr-4">03</span>
                  <p class="text-util-text">
                    Gulir ke bawah dan ketuk{" "}
                    <strong class="text-util-heading">Configure DNS</strong>
                  </p>
                </li>
                <li class="flex">
                  <span class="font-mono text-util-text mr-4">04</span>
                  <div>
                    <p class="text-util-text mb-3">
                      Ubah mode menjadi{" "}
                      <strong class="text-util-heading">Manual</strong>. Hapus
                      entri DNS yang ada, ketuk{" "}
                      <strong class="text-util-heading">Add Server</strong> dan
                      masukkan:
                    </p>
                    <code class="block bg-util-bg border border-util-border p-3 text-util-heading font-mono text-sm">
                      34.171.234.178
                    </code>
                  </div>
                </li>
                <li class="flex">
                  <span class="font-mono text-util-text mr-4">✓</span>
                  <p class="text-util-text">
                    Ketuk <strong class="text-util-heading">Save</strong> di
                    pojok kanan atas untuk menyimpan konfigurasi.
                  </p>
                </li>
              </ol>
            </div>
          </div>
        </div>

        <!-- Windows -->
        <div id="windows" class="tab-content hidden">
          <h3 class="text-2xl font-medium text-util-heading mb-6">
            Konfigurasi Windows 11
          </h3>
          <ol class="space-y-6 max-w-2xl">
            <li class="flex">
              <span class="font-mono text-util-accent mr-4">01</span>
              <p class="text-util-text">
                Buka <strong class="text-util-heading">Settings</strong> &gt;{" "}
                <strong class="text-util-heading">Network & internet</strong>
              </p>
            </li>
            <li class="flex">
              <span class="font-mono text-util-accent mr-4">02</span>
              <p class="text-util-text">
                Pilih koneksi aktif (Wi-Fi atau Ethernet)
              </p>
            </li>
            <li class="flex">
              <span class="font-mono text-util-accent mr-4">03</span>
              <p class="text-util-text">
                Pada bagian DNS server assignment, klik{" "}
                <strong class="text-util-heading">Edit</strong>
              </p>
            </li>
            <li class="flex">
              <span class="font-mono text-util-accent mr-4">04</span>
              <p class="text-util-text">
                Ubah ke <strong class="text-util-heading">Manual</strong>,
                aktifkan IPv4
              </p>
            </li>
            <li class="flex">
              <span class="font-mono text-util-accent mr-4">05</span>
              <div>
                <p class="text-util-text mb-3">
                  Masukkan IP berikut di Preferred DNS:
                </p>
                <code class="block bg-util-bg border border-util-border p-3 text-util-heading font-mono text-sm">
                  34.171.234.178
                </code>
              </div>
            </li>
          </ol>
        </div>

        <!-- MacOS -->
        <div id="mac" class="tab-content hidden">
          <h3 class="text-2xl font-medium text-util-heading mb-6">
            Konfigurasi macOS
          </h3>
          <ol class="space-y-6 max-w-2xl">
            <li class="flex">
              <span class="font-mono text-util-accent mr-4">01</span>
              <p class="text-util-text">
                Buka <strong class="text-util-heading">System Settings</strong>
              </p>
            </li>
            <li class="flex">
              <span class="font-mono text-util-accent mr-4">02</span>
              <p class="text-util-text">
                Klik <strong class="text-util-heading">Network</strong>, pilih
                koneksi aktif (Wi-Fi/Ethernet), klik{" "}
                <strong class="text-util-heading">Details...</strong>
              </p>
            </li>
            <li class="flex">
              <span class="font-mono text-util-accent mr-4">03</span>
              <p class="text-util-text">
                Pilih tab <strong class="text-util-heading">DNS</strong>
              </p>
            </li>
            <li class="flex">
              <span class="font-mono text-util-accent mr-4">04</span>
              <div>
                <p class="text-util-text mb-3">
                  Klik tombol <strong class="text-util-heading">+</strong> dan
                  tambahkan alamat ini:
                </p>
                <code class="block bg-util-bg border border-util-border p-3 text-util-heading font-mono text-sm">
                  34.171.234.178
                </code>
              </div>
            </li>
            <li class="flex">
              <span class="font-mono text-util-accent mr-4">05</span>
              <p class="text-util-text">
                Klik <strong class="text-util-heading">OK</strong> lalu Apply.
              </p>
            </li>
          </ol>
        </div>

        <!-- Router -->
        <div id="router" class="tab-content hidden">
          <h3 class="text-2xl font-medium text-util-heading mb-6">
            Konfigurasi Global di Router
          </h3>
          <p class="text-util-text mb-8">
            Melindungi seluruh perangkat di rumah sekaligus tanpa perlu setup
            satu per satu.
          </p>
          <ol class="space-y-6 max-w-2xl">
            <li class="flex">
              <span class="font-mono text-util-accent mr-4">01</span>
              <p class="text-util-text">
                Login ke admin panel router (biasanya{" "}
                <code class="text-util-heading">192.168.1.1</code> atau{" "}
                <code class="text-util-heading">192.168.0.1</code>)
              </p>
            </li>
            <li class="flex">
              <span class="font-mono text-util-accent mr-4">02</span>
              <p class="text-util-text">
                Cari pengaturan{" "}
                <strong class="text-util-heading">
                  DHCP / DNS / LAN Settings
                </strong>
              </p>
            </li>
            <li class="flex">
              <span class="font-mono text-util-accent mr-4">03</span>
              <div>
                <p class="text-util-text mb-3">
                  Ubah Primary/Secondary DNS Server ke:
                </p>
                <code class="block bg-util-bg border border-util-border p-3 text-util-heading font-mono text-sm">
                  34.171.234.178
                </code>
              </div>
            </li>
            <li class="flex">
              <span class="font-mono text-util-accent mr-4">04</span>
              <p class="text-util-text">
                Simpan pengaturan dan{" "}
                <strong class="text-util-heading">Restart Router</strong>.
              </p>
            </li>
          </ol>
        </div>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const tabs = document.querySelectorAll(".tab-btn");
        const contents = document.querySelectorAll(".tab-content");

        tabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            // Remove active classes
            tabs.forEach((t) => {
              t.classList.remove(
                "active",
                "border-util-accent",
                "bg-util-bg",
                "text-util-heading",
              );
              t.classList.add("border-transparent", "text-util-text");
            });
            contents.forEach((c) => {
              c.classList.add("hidden");
              c.classList.remove("active", "animate-fade-in");
            });

            // Add active classes to clicked tab
            tab.classList.add(
              "active",
              "border-util-accent",
              "bg-util-bg",
              "text-util-heading",
            );
            tab.classList.remove("border-transparent", "text-util-text");

            // Show corresponding content
            const target = document.getElementById(
              tab.getAttribute("data-target") || "",
            );
            if (target) {
              target.classList.remove("hidden");
              target.classList.add("active", "animate-fade-in");
            }
          });
        });
      });
    </script>
  </div>
</section>
